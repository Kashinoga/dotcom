{
	"id": "/apps/text-editor",
	"name": "Text Editor",
	"short_name": "Text Editor",
	"description": "A Markdown editor, set as a page of the manual it renders.",
	"start_url": "/apps/text-editor",
	"scope": "/apps/text-editor",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#ffffff",
	"theme_color": "#ffffff",
	"categories": ["productivity", "utilities"],
	"icons": [
		{
			"src": "/icons/text-editor-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/text-editor-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/text-editor-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"file_handlers": [
		{
			"action": "/apps/text-editor",
			"accept": {
				"text/markdown": [".md", ".markdown", ".mdown", ".mkd"],
				"text/plain": [".txt", ".text"],
				"text/javascript": [".js", ".mjs", ".cjs", ".jsx"],
				"text/x-typescript": [".ts", ".tsx"],
				"application/json": [".json", ".jsonc"],
				"text/css": [".css", ".scss", ".less"],
				"text/html": [".html", ".svelte", ".vue"],
				"text/x-python": [".py"],
				"text/x-shellscript": [".sh", ".bash", ".zsh", ".fish"],
				"text/x-yaml": [".yaml", ".yml"],
				"text/x-toml": [".toml"],
				"application/sql": [".sql"],
				"application/xml": [".xml", ".svg"],
				"text/x-rust": [".rs"],
				"text/x-go": [".go"]
			}
		}
	],
	"launch_handler": {
		"client_mode": "focus-existing"
	}
}
