{
	"name": "home",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"dependencies": {
		"@kashinoga/puhig": "workspace:*",
		"@threlte/core": "^8.5.16",
		"three": "^0.185.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:og": "node --experimental-strip-types --import ./test/register.mjs scripts/gen-og.mjs",
		"test:e2e": "node e2e/run.mjs",
		"test:e2e:changed": "node e2e/run.mjs --changed"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"@types/three": "^0.185.1",
		"playwright": "^1.61.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
